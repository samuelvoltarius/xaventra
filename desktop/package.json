{
  "name": "@xaventra/desktop",
  "version": "2.85.3",
  "private": true,
  "description": "Governed desktop control plane for Xaventra",
  "author": "Xaventra contributors",
  "license": "MIT",
  "repository": "https://github.com/samuelvoltarius/xaventra",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --dir --publish never",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "27.0.0-alpha.9"
  },
  "overrides": {
    "js-yaml@^4.0.0": "^4.3.2"
  },
  "build": {
    "appId": "io.xaventra.desktop",
    "productName": "Xaventra Desktop",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets/xaventra-icon.png",
        "to": "xaventra-icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "../assets/xaventra-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "maintainer": "Xaventra contributors",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "executableName": "xaventra-desktop",
      "icon": "../assets/xaventra-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "deb": {
      "packageName": "xaventra-desktop"
    },
    "mac": {
      "icon": "../assets/xaventra-icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
