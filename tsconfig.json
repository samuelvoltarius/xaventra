{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitReturns": false,
        "noFallthroughCasesInSwitch": false,
        "resolveJsonModule": true,
        "noImplicitAny": false
    },
    "include": [
        "src/daemon.ts",
        "src/cli.ts",
        "src/globals.ts",
        "src/layers/**/*",
        "src/llm/**/*",
        "src/tools/**/*",
        "src/intelligence/**/*",
        "src/memory/**/*",
        "src/training/**/*",
        "src/core/**/*",
        "src/supervisor/**/*",
        "src/devops/**/*",
        "src/dev/deploy-current-release.ts",
        "src/dev/copy-dashboard-assets.ts",
        "src/dev/release-targets.ts",
        "src/dev/verify-production-trace.ts",
        "src/infra/trace-verifier.ts",
        "src/watchdog.ts",
        "src/voice/**/*",
        "src/mcp/**/*",
        "src/acp/**/*",
        "src/startup/**/*",
        "src/integration/**/*",
        "src/config/config.ts",
        "src/terminal/theme.ts",
        "src/channels/telegram.ts",
        "src/channels/whatsapp.ts",
        "src/channels/discord.ts",
        "src/media/**/*",
        "src/utils/markdown-processor.ts",
        "src/utils/nova-utils.ts",
        "src/utils/polls.ts",
        "src/plugins/plugin-loader.ts",
        "src/agents/agent-patterns.ts",
        "src/process/**/*",
        "src/mesh/**/*",
        "src/benchmark/**/*",
        "src/resilience/**/*",
        "src/scheduler/**/*",
        "src/security/**/*",
        "src/nova-boot.ts",
        "src/nova.ts",
        "src/supervisor.ts",
        "src/utils.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/**/*.test.ts"
    ]
}
