# Nova Environment Variables
# Copy this file to .env and fill in your values.
# Tokens in .env override those in nova.config.json.

# Independent 2-of-3 mesh quorum (only used with mesh.coordination.mode=witness)
NOVA_WITNESS_ID=
NOVA_WITNESS_SECRET=
NOVA_WITNESS_PORT=9191
NOVA_WITNESS_A_SECRET=
NOVA_WITNESS_B_SECRET=
NOVA_WITNESS_C_SECRET=

# Direct/Relay mesh data plane
NOVA_MESH_DIRECT_PORT=9091
NOVA_MESH_RELAY_TOKEN=
NOVA_MESH_SUPABASE_URL=
NOVA_MESH_SUPABASE_KEY=

# Shared encrypted failover state. Use the same random value (32+ chars) on
# every HA node; keep it outside nova.config.json in production.
NOVA_HA_STATE_KEY=

# primary = normal channel owner candidate; standby = node-only failover
# candidate; disabled = never start Telegram on this node.
NOVA_TELEGRAM_MODE=primary

# Central OpenTelemetry collector. Environment values override deployment
# defaults and let every node use the nearest Tailscale/LAN endpoint.
NOVA_OTEL_ENABLED=false
NOVA_OTEL_ENDPOINT=

# Local inference cost estimation. Set these per GPU/LLM node from measured
# power and operator accounting; unset values remain explicitly unpriced.
NOVA_LOCAL_POWER_WATTS=
NOVA_ENERGY_USD_PER_KWH=0.30
NOVA_HARDWARE_USD_PER_HOUR=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_FROM=

# LLM Providers
OPENAI_API_KEY="" # optional; configure locally
ANTHROPIC_API_KEY="" # optional; configure locally
GOOGLE_API_KEY="" # optional; configure locally
GROQ_API_KEY="" # optional; configure locally
OPENROUTER_API_KEY="" # optional; configure locally
QWEN_OAUTH_CLIENT_ID="" # optional; configure locally

# Logging
LOG_LEVEL=info  # debug | info | warn | error

# Agent loop backend (default: nova). The OpenAI Agents SDK remains behind
# Nova's model router, tool policy, TaskContract, validator and Outcome Ledger.
NOVA_AGENT_BACKEND=nova  # nova | openai-agents
